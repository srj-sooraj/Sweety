{
  "name": "sweety",
  "version": "1.0.0",
  "private": true,
  "description": "Sweety – Blood Glucose Tracker full-stack application",
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND -c cyan,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "db:seed": "npm --prefix backend run db:seed",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:validate": "npm --prefix backend run prisma:validate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:deploy": "npm --prefix backend run prisma:deploy"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
